;
; PIO quadrature encoder decoder.
;
; Based on the official Raspberry Pi Pico SDK quadrature encoder example,
; adapted for use with two state machines in the same PIO block.
;
.pio_version 0
.program quadrature_encoder

; The program must be loaded at address 0 because it uses computed jumps.
.origin 0

; The lower 4 bits form: previous_AB << 2 | current_AB.
; For each transition we either do nothing, increment, or decrement Y.
;
; 00 state
JMP update      ; read 00
JMP decrement   ; read 01
JMP increment   ; read 10
JMP update      ; read 11

; 01 state
JMP increment   ; read 00
JMP update      ; read 01
JMP update      ; read 10 (invalid jump)
JMP decrement   ; read 11

; 10 state
JMP decrement   ; read 00
JMP update      ; read 01 (invalid jump)
JMP update      ; read 10
JMP increment   ; read 11

; 11 state
JMP update      ; read 00
JMP increment   ; read 01

; Decrement Y and continue.
decrement:
JMP Y--, update

.wrap_target
update:
    MOV ISR, Y
    PUSH noblock

sample_pins:
    OUT ISR, 2
    IN PINS, 2
    MOV OSR, ISR
    MOV PC, ISR

; PIO has no increment instruction. Negate/decrement/negate gives Y++.
increment:
    MOV Y, ~Y
    JMP Y--, increment_cont
increment_cont:
    MOV Y, ~Y

.wrap

% c-sdk {
#include "hardware/clocks.h"
#include "hardware/gpio.h"

static inline void quadrature_encoder_program_init(PIO pio, uint sm, uint pin, int max_step_rate) {
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 2, false);
    pio_gpio_init(pio, pin);
    pio_gpio_init(pio, pin + 1);

    gpio_pull_up(pin);
    gpio_pull_up(pin + 1);

    pio_sm_config c = quadrature_encoder_program_get_default_config(0);
    sm_config_set_in_pins(&c, pin);
    sm_config_set_jmp_pin(&c, pin);

    // Shift left, autopush disabled. The PIO program explicitly manages ISR.
    sm_config_set_in_shift(&c, false, false, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_NONE);

    if (max_step_rate == 0) {
        sm_config_set_clkdiv(&c, 1.0f);
    } else {
        // The loop takes at most about 10 PIO cycles.
        float div = (float)clock_get_hz(clk_sys) / (10.0f * max_step_rate);
        sm_config_set_clkdiv(&c, div);
    }

    pio_sm_init(pio, sm, 0, &c);
    pio_sm_set_enabled(pio, sm, true);
}

static inline int32_t quadrature_encoder_get_count(PIO pio, uint sm) {
    uint ret = 0;
    int n = (int)pio_sm_get_rx_fifo_level(pio, sm) + 1;

    // Drain all stale samples, then wait for one fresh sample.
    while (n-- > 0) {
        ret = pio_sm_get_blocking(pio, sm);
    }

    return (int32_t)ret;
}
%}
